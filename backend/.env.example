# ---------- LOCAL DEVELOPMENT (copy to .env; never commit .env) ----------
MODEL_PATH=models/tomato_vit        # local model folder (used if it already contains the model)
HOST=127.0.0.1                      # only used by `python run.py`
PORT=8000                           # only used by `python run.py`
MAX_UPLOAD_MB=8
# ALLOWED_ORIGINS=http://localhost:5500   # only if the frontend runs on a different origin

# ---------- RENDER PRODUCTION (set in render.yaml / Render dashboard, not here) ----------
# MODEL_ID=wellCh4n/tomato-leaf-disease-classification-vit
# MODEL_REVISION=<optional commit hash to pin weights>
# PYTHON_VERSION=3.12.3
# ALLOWED_ORIGINS=https://your-frontend.example.com   # leave unset when served by this app
# HF_TOKEN=<only if the model repo were private>
